# Copy to .env and fill in.

# Planning agent. Used only by the local server (never sent to the browser).
ANTHROPIC_API_KEY=

# Farmer profiles (saved plans + helper memory). Supabase dashboard → Project Settings → API:
# the Project URL and the anon / publishable key. These ARE sent to the browser; that is how
# Supabase is meant to be used. Never put the service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=